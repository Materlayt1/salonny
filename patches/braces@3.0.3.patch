diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..665cac9f701dac04e02fa0be0cacd438892d3c41
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,17 @@
+'use strict';
+
+// Bound recursive AST walkers even when callers provide a prebuilt AST.
+module.exports = ast => {
+  const stack = [[ast, 0]];
+  const seen = new Set();
+  while (stack.length) {
+    const [node, depth] = stack.pop();
+    if (depth > 64 || seen.has(node)) {
+      throw new SyntaxError('Brace nesting exceeds the safe depth limit');
+    }
+    seen.add(node);
+    if (node && node.nodes) {
+      for (const child of node.nodes) stack.push([child, depth + 1]);
+    }
+  }
+};
