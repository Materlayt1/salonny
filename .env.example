# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Emergency switch for a paused/deleted project; disables auth/network retries.
NEXT_PUBLIC_SUPABASE_OFFLINE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated web origins allowed to call the API with mobile bearer tokens.
# Native iOS/Android requests do not require CORS.
MOBILE_ALLOWED_ORIGINS=
NEXT_PUBLIC_BRAND_NAME=PROJECT_NAME
NEXT_PUBLIC_BRAND_LEGAL_NAME=PROJECT_NAME Teknoloji A.Ş.
GOOGLE_SITE_VERIFICATION=

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
MAP_PROVIDER_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=PROJECT_NAME/0.1 (https://example.com)
PAYMENT_PROVIDER_KEY=
WHATSAPP_ACCESS_TOKEN=
SMS_PROVIDER_KEY=
EMAIL_PROVIDER_KEY=
EMAIL_PROVIDER_URL=
SMS_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=
PUSH_PROVIDER_URL=
PUSH_PROVIDER_KEY=
AI_API_KEY=
CRON_SECRET=
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=

# Distributed rate limiting is required for production/preview critical writes.
# Prefer a complete Upstash pair. A partially set pair fails closed; credentials
# are never mixed with another family. Keep all Redis credentials server-only.
# REST URLs must use HTTPS without embedded credentials, query or fragment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel native Upstash integration aliases (complete writable pair supported).
# Do not use KV_REST_API_READ_ONLY_TOKEN for the atomic rate limiter.
KV_REST_API_URL=
KV_REST_API_TOKEN=
RATE_LIMIT_NAMESPACE=project-name
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.05
# Optional when the platform reuses one immutable build across every instance.
# Required when separate instances are built independently; use a base64 AES key.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
NEXT_DEPLOYMENT_ID=
# Read-only continuity snapshot used only when the live marketplace is unreachable.
ENABLE_LAST_KNOWN_MARKETPLACE=true
