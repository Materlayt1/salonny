# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Emergency switch for a paused/deleted project; disables auth/network retries.
NEXT_PUBLIC_SUPABASE_OFFLINE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=PROJECT_NAME
NEXT_PUBLIC_BRAND_LEGAL_NAME=PROJECT_NAME Teknoloji A.Ş.
GOOGLE_SITE_VERIFICATION=

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
MAP_PROVIDER_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=PROJECT_NAME/0.1 (https://example.com)
PAYMENT_PROVIDER_KEY=
WHATSAPP_ACCESS_TOKEN=
SMS_PROVIDER_KEY=
EMAIL_PROVIDER_KEY=
EMAIL_PROVIDER_URL=
SMS_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=
PUSH_PROVIDER_URL=
PUSH_PROVIDER_KEY=
AI_API_KEY=
CRON_SECRET=
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=

# Optional distributed rate limiting (recommended on Vercel/production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_NAMESPACE=project-name
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.05
# Read-only continuity snapshot used only when the live marketplace is unreachable.
ENABLE_LAST_KNOWN_MARKETPLACE=true
