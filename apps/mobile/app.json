{
  "expo": {
    "name": "Salonny",
    "slug": "salonny",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salonny",
    "userInterfaceStyle": "light",
    "primaryColor": "#6C4BF4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salonny.app"
    },
    "android": {
      "package": "com.salonny.app",
      "adaptiveIcon": {
        "backgroundColor": "#6C4BF4",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      ["expo-location", { "locationWhenInUsePermission": "Yakınındaki işletmeleri sıralamak için yaklaşık konumunu kullanırız. Arka planda konum takibi yapılmaz.", "isIosBackgroundLocationEnabled": false, "isAndroidBackgroundLocationEnabled": false, "isAndroidForegroundServiceEnabled": false }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#6C4BF4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
