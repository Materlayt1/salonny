{
  "name": "salonny",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:browser-performance": "node scripts/browser-performance.mjs",
    "test:load": "node scripts/load-smoke.mjs",
    "test:production-readiness": "node scripts/production-readiness.mjs",
    "test:security": "node scripts/security-audit.mjs",
    "mobile:start": "pnpm --filter @salonny/mobile start",
    "mobile:android": "pnpm --filter @salonny/mobile android",
    "mobile:ios": "pnpm --filter @salonny/mobile ios",
    "mobile:typecheck": "pnpm --filter @salonny/mobile typecheck",
    "mobile:export": "pnpm --filter @salonny/mobile exec expo export --platform web --clear",
    "mobile:preview": "node scripts/mobile-preview.mjs",
    "mobile:export:preview": "node scripts/export-mobile-preview.mjs",
    "mobile:bundle": "pnpm --filter @salonny/mobile exec expo export --platform all --clear",
    "mobile:test:e2e": "playwright test --config playwright.mobile.config.ts"
  },
  "dependencies": {
    "@salonny/contracts": "workspace:*",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.4.1",
    "next": "16.3.6",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "pg": "^8.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
